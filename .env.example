NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://amrutam_user:CHANGE_ME@127.0.0.1:5432/amrutam
TEST_DATABASE_URL=postgresql://amrutam_user:CHANGE_ME@127.0.0.1:5432/amrutam_test

# Redis (local compose binds to localhost)
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=CHANGE_ME

# JWT_SECRET must be at least 32 characters
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=7

# Comma-separated browser origins
CORS_ORIGIN=http://localhost:5173
